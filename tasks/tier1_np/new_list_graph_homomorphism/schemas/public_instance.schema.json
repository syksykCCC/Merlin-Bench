{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aipbench://t1.new_list_graph_homomorphism/public-instance/1",
  "type": "object",
  "required": ["format_version", "source_num_vertices", "source_edges", "target_num_vertices", "target_edges", "lists"],
  "properties": {
    "format_version": {"const": "aip-list-graph-homomorphism-instance/1"},
    "source_num_vertices": {"type": "integer", "minimum": 1},
    "source_edges": {"type": "array", "items": {"$ref": "#/$defs/undirected_edge"}},
    "target_num_vertices": {"type": "integer", "minimum": 1},
    "target_edges": {"type": "array", "items": {"$ref": "#/$defs/undirected_edge"}},
    "lists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_vertex", "allowed_targets"],
        "properties": {
          "source_vertex": {"type": "integer", "minimum": 1},
          "allowed_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "undirected_edge": {
      "type": "object",
      "required": ["edge_id", "u", "v"],
      "properties": {
        "edge_id": {"type": "integer", "minimum": 0},
        "u": {"type": "integer", "minimum": 1},
        "v": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
