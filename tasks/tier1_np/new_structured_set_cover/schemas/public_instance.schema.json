{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aipbench://t1.new_structured_set_cover/public-instance/1",
  "x-aipbench-total-incidence-maximum": 100000,
  "type": "object",
  "required": ["format_version", "num_elements", "sets", "budget"],
  "properties": {
    "format_version": {"const": "aip-structured-set-cover-instance/1"},
    "num_elements": {"type": "integer", "minimum": 1, "maximum": 4096},
    "sets": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "required": ["set_id", "elements", "weight"],
        "properties": {
          "set_id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "elements": {
            "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 4096}
          },
          "weight": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
        },
        "additionalProperties": false
      }
    },
    "budget": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  },
  "additionalProperties": false
}
