{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aipbench://t2.image_size_lower_bound/public-instance/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "circuit", "threshold_exponent", "hash_lanes"],
  "properties": {
    "format_version": {"const": "aip-image-size/1"},
    "threshold_exponent": {"type": "integer", "minimum": 0, "maximum": 60},
    "hash_lanes": {"const": 128},
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num_inputs", "num_outputs", "gates", "outputs"],
      "properties": {
        "num_inputs": {"type": "integer", "minimum": 1, "maximum": 16},
        "num_outputs": {"type": "integer", "minimum": 1, "maximum": 64},
        "gates": {
          "type": "array",
          "maxItems": 20000,
          "items": {"$ref": "#/$defs/gate"}
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "value"],
          "properties": {"op": {"const": "const"}, "value": {"enum": [0, 1]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "input"],
          "properties": {
            "op": {"const": "not"},
            "input": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "left", "right"],
          "properties": {
            "op": {"enum": ["xor", "and"]},
            "left": {"type": "integer", "minimum": 0},
            "right": {"type": "integer", "minimum": 0}
          }
        }
      ]
    }
  }
}
