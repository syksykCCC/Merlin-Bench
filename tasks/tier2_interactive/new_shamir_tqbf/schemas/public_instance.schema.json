{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aipbench://t2.new_shamir_tqbf/public-instance/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "field_codec", "quantifiers", "circuit"],
  "properties": {
    "format_version": {"const": "aip-tqbf/1"},
    "field_codec": {"const": "field61/hex-v1"},
    "quantifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 44,
      "items": {"enum": ["forall", "exists"]}
    },
    "circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num_inputs", "gates", "output"],
      "properties": {
        "num_inputs": {"type": "integer", "minimum": 1, "maximum": 44},
        "gates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "value"],
                "properties": {
                  "op": {"const": "const"},
                  "value": {"enum": [0, 1]}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "input"],
                "properties": {
                  "op": {"const": "not"},
                  "input": {"type": "integer", "minimum": 0}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "left", "right"],
                "properties": {
                  "op": {"enum": ["and", "or", "xor"]},
                  "left": {"type": "integer", "minimum": 0},
                  "right": {"type": "integer", "minimum": 0}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "condition", "zero", "one"],
                "properties": {
                  "op": {"const": "ite"},
                  "condition": {"type": "integer", "minimum": 0},
                  "zero": {"type": "integer", "minimum": 0},
                  "one": {"type": "integer", "minimum": 0}
                }
              }
            ]
          }
        },
        "output": {"type": "integer", "minimum": 0}
      }
    }
  }
}
