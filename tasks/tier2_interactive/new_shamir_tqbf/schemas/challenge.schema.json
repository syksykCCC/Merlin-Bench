{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aipbench://t2.new_shamir_tqbf/challenge/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["round_index", "point", "next_round"],
  "properties": {
    "round_index": {"type": "integer", "minimum": 0},
    "point": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "next_round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round_index", "stage", "operator", "variable", "degree_bound", "remaining_barriers"],
      "properties": {
        "round_index": {"type": "integer", "minimum": 0},
        "stage": {"type": "integer", "minimum": 1},
        "operator": {"enum": ["reduce", "forall", "exists"]},
        "variable": {"type": "integer", "minimum": 0},
        "degree_bound": {"type": "integer", "minimum": 0, "maximum": 64},
        "remaining_barriers": {"type": "integer", "minimum": 1}
      }
    }
  }
}
