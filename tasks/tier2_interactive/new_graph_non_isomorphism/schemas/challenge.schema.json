{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aipbench://t2.new_graph_non_isomorphism/gni.challenge/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["graphs"],
  "properties": {
    "graphs": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/graph"}
    }
  },
  "$defs": {
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num_vertices", "colors", "edges"],
      "properties": {
        "num_vertices": {"type": "integer", "minimum": 1},
        "colors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
