{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aipbench://t2.new_graph_non_isomorphism/public-instance/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "graph_model", "challenge_lanes", "graphs"],
  "properties": {
    "format_version": {"const": "aip-gni-instance/1"},
    "graph_model": {"const": "undirected_simple_vertex_colored"},
    "challenge_lanes": {"const": 24},
    "graphs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/graph"}
    }
  },
  "$defs": {
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num_vertices", "colors", "edges"],
      "properties": {
        "num_vertices": {"type": "integer", "minimum": 1},
        "colors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
