{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aipbench://t2.new_gkr_layered_circuit/event/reduce/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["layer", "left_value", "right_value", "line_coefficients"],
  "properties": {
    "layer": {"type": "integer", "minimum": 0, "maximum": 511},
    "left_value": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "right_value": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "line_coefficients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 21,
      "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
    }
  }
}
