{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aipbench://t2.new_gkr_layered_circuit/event/poly/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["layer", "round", "coefficients"],
  "properties": {
    "layer": {"type": "integer", "minimum": 0, "maximum": 511},
    "round": {"type": "integer", "minimum": 0, "maximum": 39},
    "coefficients": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
    }
  }
}
