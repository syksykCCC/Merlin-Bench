{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aipbench://t2.new_boolean_hypercube_sumcheck/public-instance/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "field", "num_variables", "factors"],
  "properties": {
    "format_version": {"const": "aip-sumcheck-instance/1"},
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modulus", "codec"],
      "properties": {
        "modulus": {"const": "1fffffffffffffff"},
        "codec": {"const": "field61/hex-v1"}
      }
    },
    "num_variables": {"type": "integer", "minimum": 1, "maximum": 400},
    "factors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "values"],
        "properties": {
          "scope": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0, "maximum": 399}
          },
          "values": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "items": {"$ref": "#/$defs/field"}
          }
        }
      }
    }
  },
  "$defs": {
    "field": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
  }
}
