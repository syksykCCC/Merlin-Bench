{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aipbench://t2.new_boolean_hypercube_sumcheck/sumcheck.poly/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["round_index", "coefficients"],
  "properties": {
    "round_index": {"type": "integer", "minimum": 0, "maximum": 399},
    "coefficients": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
    }
  }
}
