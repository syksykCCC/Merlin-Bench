{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merlin-Bench external harness manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "api_version", "task", "case", "limits", "files"],
  "properties": {
    "schema_version": {"const": "aip-harness/1"},
    "api_version": {"const": "aip/1"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "fixture_id": {"type": "string", "minLength": 1}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_seconds"],
      "properties": {"wall_time_seconds": {"type": "integer", "minimum": 1}}
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "task_specification",
        "instance",
        "protocol",
        "client",
        "connection"
      ],
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
        "task_specification": {"type": "string", "minLength": 1},
        "instance": {"type": "string", "minLength": 1},
        "protocol": {"type": "string", "minLength": 1},
        "client": {"type": "string", "minLength": 1},
        "connection": {"type": "string", "minLength": 1}
      }
    }
  }
}
